# Copy to .env and adjust. Never commit .env.

# --- Database ---
WISE_POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Host port for Postgres (loopback only). Used by `make dev`.
WISE_POSTGRES_PORT=5433

# --- Repositories ---
# Absolute host directory containing the repositories Wise may register.
# Mounted read-only into the API container at the same path.
WISE_REPO_ROOT=/home/you/Projects
# UID/GID the API container runs as (should be able to read WISE_REPO_ROOT).
WISE_UID=1000
WISE_GID=1000

# --- Auth ---
# Creates the first admin on boot when no users exist (min. 12 characters).
WISE_BOOTSTRAP_ADMIN_USER=admin
WISE_BOOTSTRAP_ADMIN_PASSWORD=
WISE_SESSION_TTL=168h
# Set true when serving over HTTPS.
WISE_COOKIE_SECURE=false

# --- Misc ---
# Go module proxy used when building the API image.
# GOPROXY=https://proxy.golang.org,direct
WISE_LOG_LEVEL=info
WISE_DASHBOARD_PORT=5173

# --- Used only by `make dev` (API running on the host) ---
# WISE_DATABASE_URL=postgres://wise:<password>@127.0.0.1:5433/wise?sslmode=disable
# WISE_REPO_ROOTS=/home/you/Projects
# WISE_CORS_ORIGINS=
