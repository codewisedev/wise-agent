# Copy to .env and adjust. Never commit .env.

# --- Database ---
WISE_POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Host port for Postgres (loopback only). Used by `make dev`.
WISE_POSTGRES_PORT=5433
# Password of the unprivileged `temporal` role (Temporal's own databases).
WISE_TEMPORAL_DB_PASSWORD=change-me-to-another-long-random-string

# --- Repositories ---
# Absolute host directory containing the repositories Wise may register.
# Mounted read-only into the API container at the same path.
WISE_REPO_ROOT=/home/you/Projects
# UID/GID the API container runs as (should be able to read WISE_REPO_ROOT).
WISE_UID=1000
WISE_GID=1000

# --- Auth ---
# Creates the first admin on boot when no users exist (min. 12 characters).
WISE_BOOTSTRAP_ADMIN_USER=admin
WISE_BOOTSTRAP_ADMIN_PASSWORD=
WISE_SESSION_TTL=168h
# Set true when serving over HTTPS.
WISE_COOKIE_SECURE=false

# --- Agents & models (Phase 2) ---
# Shared secret the agent runtime uses to claim runs (>= 32 chars): openssl rand -hex 32
WISE_RUNTIME_TOKEN=
# LM Studio: URL used when the API runs on the host (make dev) ...
WISE_LMSTUDIO_URL=http://127.0.0.1:1234/v1
# ... and from Docker (requires LM Studio "Serve on Local Network").
WISE_LMSTUDIO_DOCKER_URL=http://host.docker.internal:1234/v1
# Model id to use; empty = whichever chat model LM Studio has loaded.
WISE_LMSTUDIO_MODEL=
# LM Studio API token, if "Require Authentication" is on (Developer → Server Settings).
WISE_LMSTUDIO_API_KEY=
# Claude Code subscription token from `claude setup-token` (Docker only; `make dev` uses your login).
CLAUDE_CODE_OAUTH_TOKEN=
# Encrypts account credentials stored from the dashboard: `openssl rand -base64 32`.
WISE_SECRETS_KEY=
# Shared secret between the API and the CLI runner (32+ chars): `openssl rand -hex 32`.
WISE_CLI_RUNNER_TOKEN=
# Shared secret between the API/orchestrator, the executor and the egress proxy (32+ chars): `openssl rand -hex 32`.
WISE_EXECUTOR_TOKEN=
# Read-only token the egress proxy uses to fetch its allowlist (32+ chars, different from the above).
WISE_EGRESS_TOKEN=

# --- Misc ---
# Go module proxy used when building the API image.
# GOPROXY=https://proxy.golang.org,direct
WISE_LOG_LEVEL=info
WISE_DASHBOARD_PORT=5173

# --- Used only by `make dev` (API running on the host) ---
# WISE_DATABASE_URL=postgres://wise:<password>@127.0.0.1:5433/wise?sslmode=disable
# WISE_REPO_ROOTS=/home/you/Projects
# WISE_CORS_ORIGINS=
